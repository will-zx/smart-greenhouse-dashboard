#ifndef SECRETS_H
#define SECRETS_H

// WiFi
#define WIFI_SSID       "YOUR_WIFI_SSID"
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"

// Firebase Auth — akun perangkat, satu per unit greenhouse.
// Salin file ini ke secrets.h lalu isi nilainya. Jangan commit secrets.h.
// DEVICE_ID juga menentukan path RTDB: /zones/<DEVICE_ID>/sensor_logs
#define FIREBASE_API_KEY    "YOUR_FIREBASE_API_KEY"
#define DEVICE_ID           "esp32-gh-01"
#define DEVICE_EMAIL        "esp32-gh-01@device.local"
#define DEVICE_PASSWORD     "YOUR_DEVICE_PASSWORD"

#endif
