[General]
version=2.0
type=mamdani
name=fuzzy_ctrl_esp32
method=min
location=0,0
opts=CNF,3,1,3,0,0,0

[Input1]
name=Temperature
range=[0 50]
NumMFs=3
MF1=Cold : trimf : [10 18 25]
MF2=Opt : trimf : [22 27 32]
MF3=Hot : trimf : [28 34 42]

[Input2]
name=Humidity
range=[0 100]
NumMFs=3
MF1=Low : trimf : [0 30 55]
MF2=Opt : trimf : [45 65 80]
MF3=High : trimf : [70 85 100]

[Input3]
name=Soil
range=[0 100]
NumMFs=3
MF1=Dry : trimf : [0 15 35]
MF2=Opt : trimf : [30 50 70]
MF3=Wet : trimf : [60 80 100]

[Input4]
name=VPD
range=[0 3]
NumMFs=2
MF1=Low : trimf : [0 0.2 0.5]
MF2=High : trimf : [1.3 1.6 2]

[Input5]
name=ETc
range=[0 18]
NumMFs=2
MF1=Low : trimf : [0 4 8]
MF2=High : trimf : [5 9 18]

[Output1]
name=misting
range=[0 1]
NumMFs=4
MF1=Off : trimf : [0 0.015 0.03]
MF2=Low : trimf : [0.15 0.3 0.45]
MF3=Med : trimf : [0.45 0.6 0.75]
MF4=High : trimf : [0.85 1 1]

[Output2]
name=blower
range=[0 1]
NumMFs=4
MF1=Off : trimf : [0 0.015 0.03]
MF2=Low : trimf : [0.25 0.4 0.55]
MF3=Med : trimf : [0.55 0.7 0.85]
MF4=High : trimf : [0.85 1 1]

[Output3]
name=irigasi
range=[0 1]
NumMFs=3
MF1=Off : trimf : [0 0.015 0.03]
MF2=Low : trimf : [0.35 0.5 0.65]
MF3=High : trimf : [0.85 1 1]

[Rules1]
3 3 (TH) : 7 7 (SD) -> 1 (High)
3 3 (TH) : 8 8 (SO) -> 1 (Med)
3 3 (TH) : 9 9 (SW) -> 1 (Low)
3 3 (TH) : 11 11 (VH) -> 1 (High)
2 2 (TO) : 7 7 (SD) -> 1 (Med)
2 2 (TO) : 11 11 (VH) -> 1 (Med)
1 1 (TC) : 1 1 (TC) -> 1 (Off)
2 2 (TO) : 9 9 (SW) -> 1 (Off)
10 10 (VL) : 10 10 (VL) -> 1 (Off)

[Rules2]
3 3 (TH) : 6 6 (HH) -> 2 (High)
2 2 (TO) : 6 6 (HH) -> 2 (Med)
3 3 (TH) : 4 4 (HL) -> 2 (Low)
3 3 (TH) : 5 5 (HO) -> 2 (Med)
2 2 (TO) : 5 5 (HO) -> 2 (Low)
10 10 (VL) : 10 10 (VL) -> 2 (Low)
1 1 (TC) : 1 1 (TC) -> 2 (Off)

[Rules3]
7 7 (SD) : 13 13 (EH) -> 3 (High)
7 7 (SD) : 12 12 (EL) -> 3 (Low)
8 8 (SO) : 13 13 (EH) -> 3 (Low)
8 8 (SO) : 12 12 (EL) -> 3 (Off)
9 9 (SW) : 9 9 (SW) -> 3 (Off)

